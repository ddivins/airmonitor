      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "airmonitor-sqlite"
          },
          "queryText": "SELECT CAST(strftime('%s', sampled_at) AS INTEGER) AS time, humidity_rh FROM sgx_voc_samples ORDER BY sampled_at",
