{
  "uid": "airmonitor-live",
  "title": "AirMonitor Live",
  "style": "light",
  "tags": ["airmonitor", "environment"],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 3,
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s", "30s", "1m", "5m"]},
  "editable": true,
  "graphTooltip": 1,
  "annotations": {"list": []},
  "templating": {"list": []},
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Current VOC",
      "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"}, "queryText": "SELECT sampled_at AS time, gas_ppm AS voc_ppm FROM sgx_voc_samples ORDER BY sampled_at;"}],
      "fieldConfig": {"defaults": {"unit": "ppm", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "orange", "value": 3}, {"color": "red", "value": 10}]}, "mappings": []}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "fields": "voc_ppm", "calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current Temperature",
      "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"}, "queryText": "SELECT sampled_at AS time, temperature_c FROM sgx_voc_samples ORDER BY sampled_at;"}],
      "fieldConfig": {"defaults": {"unit": "celsius", "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "fields": "temperature_c", "calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current Humidity",
      "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"}, "queryText": "SELECT sampled_at AS time, humidity_rh FROM sgx_voc_samples ORDER BY sampled_at;"}],
      "fieldConfig": {"defaults": {"unit": "humidity", "mappings": [], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"values": false, "fields": "humidity_rh", "calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area", "justifyMode": "auto"}
    },
    {
      "id": 4,
      "type": "table",
      "title": "Printer",
      "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"}, "queryText": "SELECT COALESCE(last_gcode_state, ended_gcode_state, started_gcode_state) AS state, filament_type AS filament, subtask_name AS file, filament_emission_class AS emissions, room_filter_recommended AS room_filter FROM prints ORDER BY last_seen_at DESC LIMIT 1;"}],
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "mappings": []}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "VOC History",
      "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 4},
      "targets": [{"refId": "A", "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"}, "queryText": "SELECT sampled_at AS time, gas_ppm AS voc_ppm FROM sgx_voc_samples ORDER BY sampled_at;"}],
      "fieldConfig": {"defaults": {"unit": "ppm", "custom": {"axisLabel": "ppm", "axisSoftMin": 0, "axisSoftMax": 5, "drawStyle": "line", "lineWidth": 3, "fillOpacity": 12, "gradientMode": "opacity", "showPoints": "never", "lineInterpolation": "smooth"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "orange", "value": 3}, {"color": "red", "value": 10}]}, "mappings": []}, "overrides": []},
      "options": {"legend": {"showLegend": true, "placement": "bottom", "displayMode": "list", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "single", "sort": "none"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Temperature / Humidity",
      "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "targets": [{"refId": "A", "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"}, "queryText": "SELECT sampled_at AS time, temperature_c, humidity_rh FROM sgx_voc_samples ORDER BY sampled_at;"}],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "lineInterpolation": "smooth"}, "mappings": []}, "overrides": [{"matcher": {"id": "byName", "options": "temperature_c"}, "properties": [{"id": "unit", "value": "celsius"}, {"id": "custom.axisLabel", "value": "°C"}]}, {"matcher": {"id": "byName", "options": "humidity_rh"}, "properties": [{"id": "unit", "value": "humidity"}, {"id": "custom.axisLabel", "value": "%RH"}, {"id": "custom.axisPlacement", "value": "right"}]}]},
      "options": {"legend": {"showLegend": true, "placement": "bottom", "displayMode": "list", "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 7,
      "type": "table",
      "title": "Latest Samples",
      "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"},
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 21},
      "targets": [{"refId": "A", "datasource": {"type": "frser-sqlite-datasource", "uid": "airmonitor-sqlite"}, "queryText": "SELECT s.sampled_at, s.gas_ppm, s.temperature_c, s.humidity_rh, p.last_gcode_state AS printer_state, p.filament_type, p.subtask_name FROM sgx_voc_samples s LEFT JOIN prints p ON p.id = s.print_id ORDER BY s.sampled_at DESC LIMIT 10;"}],
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}, "inspect": false}, "mappings": []}, "overrides": []},
      "options": {"showHeader": true, "cellHeight": "sm", "footer": {"show": false}}
    }
  ]
}
