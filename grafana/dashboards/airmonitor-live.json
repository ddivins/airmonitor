      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Latest Sample",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "airmonitor-sqlite"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "airmonitor-sqlite"
          },
          "queryText": "SELECT sampled_at, printf('%.2f', gas_ppm) AS voc_ppm, printf('%.1f C', temperature_c) AS temperature, printf('%.1f %%', humidity_rh) AS humidity FROM sgx_voc_samples ORDER BY id DESC LIMIT 1",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "VOC History",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "airmonitor-sqlite"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "airmonitor-sqlite"
          },
          "queryText": "SELECT CAST(strftime('%s', sampled_at) AS INTEGER) AS time, gas_ppm AS voc_ppm FROM sgx_voc_samples ORDER BY sampled_at",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0,
            "axisSoftMax": 5
          },
          "mappings": [],
          "unit": "ppm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
