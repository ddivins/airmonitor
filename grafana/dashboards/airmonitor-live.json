    {
      "id": 1,
      "type": "timeseries",
      "title": "SGX VOC History",
      "datasource": {
        "type": "frser-sqlite-datasource",
        "uid": "airmonitor-sqlite"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "airmonitor-sqlite"
          },
          "queryText": "SELECT CAST(strftime('%s', sampled_at) AS INTEGER) AS time, gas_ppm AS voc_ppm FROM sgx_voc_samples WHERE CAST(strftime('%s', sampled_at) AS INTEGER) >= $__from / 1000 AND CAST(strftime('%s', sampled_at) AS INTEGER) < $__to / 1000 ORDER BY sampled_at",
          "rawQueryText": "SELECT CAST(strftime('%s', sampled_at) AS INTEGER) AS time, gas_ppm AS voc_ppm FROM sgx_voc_samples WHERE CAST(strftime('%s', sampled_at) AS INTEGER) >= $__from / 1000 AND CAST(strftime('%s', sampled_at) AS INTEGER) < $__to / 1000 ORDER BY sampled_at",
          "queryType": "time series",
          "timeColumns": [
            "time"
          ],
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "axisSoftMin": 0,
            "axisSoftMax": 5
          },
          "mappings": [],
          "unit": "ppm"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
