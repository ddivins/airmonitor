#!/bin/sh
set -eu

action="${1:-}"
service="${2:-}"

case "$service" in
    airmonitor.target)
        case "$action" in start|stop|restart) ;; *) echo "Unsupported action for $service" >&2; exit 64 ;; esac
        ;;
    airmonitor-voc.service|airmonitor-sps30.service|airmonitor-printer-mqtt.service|airmonitor-bento.service|airmonitor-levoit.service) ;;
    grafana-server.service|mosquitto.service)
        [ "$action" = restart ] || { echo "Only restart is allowed for $service" >&2; exit 64; }
        ;;
    *) echo "Unsupported service" >&2; exit 64 ;;
esac

case "$action" in
    start|stop|restart) systemctl "$action" "$service" ;;
    enable) systemctl enable --now "$service" ;;
    disable) systemctl disable --now "$service" ;;
    *) echo "Unsupported action" >&2; exit 64 ;;
esac
