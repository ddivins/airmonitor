[Unit]
Description=AirMonitor sensor logger
After=network-online.target airmonitor-printer-mqtt.service
Wants=network-online.target

[Service]
Type=simple
User=automation
Group=automation
EnvironmentFile=/etc/airmonitor/sgx-voc.env
ExecStart=/opt/airmonitor/venv/bin/airmonitor-sensor-service
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadOnlyPaths=/etc/airmonitor/sgx-voc.env
ReadWritePaths=/var/lib/airmonitor /etc/airmonitor

[Install]
WantedBy=multi-user.target
