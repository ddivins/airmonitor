[Unit]
Description=AirMonitor Bento Box filter automation
After=network-online.target airmonitor-printer-mqtt.service
Wants=network-online.target

[Service]
Type=simple
User=automation
Group=automation
EnvironmentFile=/etc/bambu-bento.env
ExecStart=/opt/airmonitor/venv/bin/bambu-bento
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
