[Unit]
Description=AirMonitor Levoit room filter automation
After=network-online.target airmonitor-printer-mqtt.service
Wants=network-online.target
PartOf=airmonitor.target

[Service]
Type=simple
User=automation
Group=automation
EnvironmentFile=/etc/airmonitor/levoit.env
ExecStart=/opt/airmonitor/venv/bin/airmonitor-levoit-service
Restart=on-failure
RestartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/airmonitor

[Install]
WantedBy=multi-user.target
