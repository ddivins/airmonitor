[Unit]
Description=AirMonitor Levoit room filter automation
After=network-online.target airmonitor-printer-mqtt.service
Wants=network-online.target

[Service]
Type=simple
User=automation
Group=automation
EnvironmentFile=/etc/airmonitor/levoit.env
ExecStart=/opt/airmonitor/venv/bin/airmonitor-levoit run
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
