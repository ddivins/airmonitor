server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name __DOMAIN__;

    ssl_certificate /etc/letsencrypt/live/__DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__DOMAIN__/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = / {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /airmonitor-offline.html;
    }

    location = /status {
        return 302 /;
    }

    location = /alerts {
        proxy_pass http://127.0.0.1:8080/alerts.html;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_intercept_errors on;
        error_page 502 503 504 =503 /airmonitor-offline.html;
    }

    location = /alerts-api {
        proxy_pass http://127.0.0.1:8080/api/alerts;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /update-api {
        proxy_pass http://127.0.0.1:8080/api/update;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /sign-in {
        proxy_pass http://127.0.0.1:8080/login.html;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /status-api {
        proxy_pass http://127.0.0.1:8080/api/status;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /session-api {
        proxy_pass http://127.0.0.1:8080/api/session;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /service-control-api {
        proxy_pass http://127.0.0.1:8080/api/services/control;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /filter-control-api {
        proxy_pass http://127.0.0.1:8080/api/filters/control;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /service-status-api {
        proxy_pass http://127.0.0.1:8080/api/services/status;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-store" always;
    }

    location = /status-healthz {
        proxy_pass http://127.0.0.1:8080/healthz;
    }

    location = /exports {
        return 301 /exports/print;
    }

    location /exports/ {
        proxy_pass http://127.0.0.1:8081/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }

    location = /exports-healthz {
        proxy_pass http://127.0.0.1:8081/healthz;
    }

    location /status-assets/ {
        proxy_pass http://127.0.0.1:8080/assets/;
    }

    location = /airmonitor-offline.html {
        internal;
        root /var/www/airmonitor;
    }

    location = /grafana {
        return 301 /grafana/;
    }

    # Grafana confines redirectTo values to its configured subpath. Rewrite the
    # successful password-login JSON response so the unified app returns to
    # the signed-in appliance landing page instead of Grafana home.
    location = /grafana/login {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Accept-Encoding "";
        proxy_cookie_path /grafana "/; Secure; HttpOnly; SameSite=Lax";
        proxy_cookie_path / "/; Secure; HttpOnly; SameSite=Lax";
        sub_filter_types application/json;
        sub_filter_once off;
        sub_filter '"redirectUrl":"/grafana/"' '"redirectUrl":"/"';
        sub_filter '"redirectUrl":"/grafana"' '"redirectUrl":"/"';
        # Same logo banner injected below for /grafana/ -- this exact-match
        # location serves the login page's HTML too, which the prefix
        # location below never sees.
        sub_filter '</head>' '<link rel="stylesheet" href="/status-assets/grafana-banner.css?v=1"></head>';
        sub_filter '<div id="reactRoot"></div>' '<a href="https://__DOMAIN__/" class="airmonitor-grafana-banner" aria-label="Back to AirMonitor status"><img src="/status-assets/airmonitor-logo-300px.webp" alt="AirMonitor"></a><div id="reactRoot"></div>';
    }

    location /grafana/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Grafana is still the session authority. Widen its subpath cookie to
        # the appliance root so /session-api can validate the same login.
        proxy_cookie_path /grafana "/; Secure; HttpOnly; SameSite=Lax";
        proxy_cookie_path / "/; Secure; HttpOnly; SameSite=Lax";

        # Inject the same clickable AirMonitor logo banner the status_static
        # pages use, so every Grafana page -- including built-in ones like
        # /grafana/dashboards that can't take a custom dashboard panel -- gets
        # the same "click the logo to get back to status" navigation. Accept-
        # Encoding is stripped so sub_filter sees Grafana's plain (uncompressed)
        # HTML instead of gzip bytes it can't pattern-match against -- the same
        # fix already used above for /grafana/login's JSON rewrite. #reactRoot
        # is Grafana's own SPA mount point; React only ever manages that one
        # subtree, so a sibling injected immediately before it survives every
        # client-side route change with no per-page work. This relies on
        # Grafana's HTML shell keeping a </head> tag and that id -- reasonably
        # stable structural anchors, but not a documented/versioned contract,
        # so a Grafana upgrade could someday stop matching (the banner would
        # just silently disappear, not break anything else).
        proxy_set_header Accept-Encoding "";
        sub_filter '</head>' '<link rel="stylesheet" href="/status-assets/grafana-banner.css?v=1"></head>';
        sub_filter '<div id="reactRoot"></div>' '<a href="https://__DOMAIN__/" class="airmonitor-grafana-banner" aria-label="Back to AirMonitor status"><img src="/status-assets/airmonitor-logo-300px.webp" alt="AirMonitor"></a><div id="reactRoot"></div>';
    }

    # Preserve historical same-host Grafana bookmarks beneath the new subpath.
    location / {
        return 301 /grafana$request_uri;
    }
}
