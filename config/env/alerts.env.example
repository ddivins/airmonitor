# Optional generic webhook: receives a JSON POST for every alert
# open/escalate/resolve transition:
#   {"alert_key", "level", "title", "message", "value", "threshold"}
ALERT_WEBHOOK_URL=

# Optional ntfy.sh (or self-hosted ntfy) push notifications.
# Leave ALERT_NTFY_TOPIC blank to disable.
ALERT_NTFY_SERVER=https://ntfy.sh
ALERT_NTFY_TOPIC=

# Neither channel above is required: alerts are always recorded in the
# database (visible via airmonitor-doctor and the status page) even with
# no notification channel configured.

# How often to evaluate thresholds and sensor/filter freshness, in seconds.
ALERT_POLL_SECONDS=30

# Path to the SQLite database (matches other services).
ALERT_DATABASE=/var/lib/airmonitor/airmonitor.sqlite3

# Optional path to a YAML file overriding the built-in default thresholds.
# See config/alert-thresholds.yaml.example.
ALERT_THRESHOLDS_PATH=/etc/airmonitor/alert-thresholds.yaml

LOG_LEVEL=INFO
