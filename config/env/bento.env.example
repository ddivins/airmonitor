# Local printer state MQTT, published by airmonitor-printer-mqtt
LOCAL_MQTT_HOST=localhost
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_TOPIC=printer/state
LOCAL_MQTT_AVAILABILITY_TOPIC=printer/available
LOCAL_MQTT_USERNAME=
LOCAL_MQTT_PASSWORD=

# Kasa outlet local-network settings
OUTLET_HOST=192.0.2.20
KASA_USERNAME=
KASA_PASSWORD=

# Filter behavior
AIRMONITOR_DATABASE=/var/lib/airmonitor/airmonitor.sqlite3
OFF_DELAY_SECONDS=1800
ON_STATES=RUNNING,PREPARE,PAUSE
TURN_OFF_ON_SERVICE_STOP=false
OUTLET_POLL_SECONDS=15

# MQTT and service health.
# MQTT_WATCHDOG_SECONDS also gates filter safety: once the local printer-state
# feed has been silent this long, any pending OFF timer is suspended and the
# last commanded outlet state is held rather than derived from a stale
# snapshot (a stale feed must not be read as "printer idle").
RECONNECT_DELAY=15
MQTT_KEEPALIVE=60
MQTT_WATCHDOG_SECONDS=300
HEARTBEAT_SECONDS=600
LOG_LEVEL=INFO
