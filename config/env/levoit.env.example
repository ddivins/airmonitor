# Levoit Filter configuration

# VeSync cloud credentials.
# Keep /etc/airmonitor/levoit.env mode 0600 because it contains credentials.
VESYNC_USERNAME=
VESYNC_PASSWORD=

# Optional IANA timezone passed to pyvesync.
VESYNC_TIME_ZONE=America/New_York

# Device selector. Prefer the exact purifier name from `airmonitor-levoit discover`.
LEVOIT_DEVICE_NAME=

# Optional manual fan speed when turning on. Leave blank to just turn the unit on.
# Common values are model-dependent. Try 1, 2, 3, or 4.
LEVOIT_FAN_SPEED=4

# VeSync cloud polling interval. The service performs one device refresh per poll.
# Default/recommended for a home office: 120 seconds. Minimum: 30 seconds.
LEVOIT_POLL_INTERVAL_SECONDS=120

# Retry schedule after login, device-discovery, or cloud failures. The final value
# repeats until VeSync recovers. Values below 60 seconds are rejected to reduce
# the chance of triggering VeSync rate limits.
LEVOIT_RETRY_BACKOFF_SECONDS=60,120,300,900,3600

# Local MQTT published by airmonitor-printer-mqtt / AirMonitor policy enrichment.
LOCAL_MQTT_HOST=localhost
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_TOPIC=printer/state
LOCAL_MQTT_CLIENT_ID=airmonitor-levoit
LOCAL_MQTT_USERNAME=
LOCAL_MQTT_PASSWORD=
LOCAL_MQTT_KEEPALIVE=60

# Control behavior.
AIRMONITOR_DATABASE=/var/lib/airmonitor/airmonitor.sqlite3
LEVOIT_AUTO_OFF_DELAY_SECONDS=1800
LEVOIT_STARTUP_ON_RECOMMENDED=true
LEVOIT_TURN_OFF_WHEN_NOT_RECOMMENDED=false

# Logging.
LOG_LEVEL=INFO
