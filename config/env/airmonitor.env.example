# AirMonitor sensor logger configuration

# Preferred: resolve the sensor from /etc/airmonitor/hardware.yaml.
AIRMONITOR_PORT=auto
AIRMONITOR_HARDWARE_ID=sgx-voc-01
AIRMONITOR_HARDWARE_REGISTRY=/etc/airmonitor/hardware.yaml

# The service stays running when a USB sensor is absent, waits for insertion,
# and reopens it after removal/reconnection.
AIRMONITOR_HARDWARE_RETRY_SECONDS=5
AIRMONITOR_DEVICE_POLL_SECONDS=1

# Set AIRMONITOR_PORT to an explicit path to bypass hardware discovery, for
# example /dev/serial0 or /dev/serial/by-id/usb-FTDI_...-if00-port0.
AIRMONITOR_SENSOR_ID=sgx-voc-01
AIRMONITOR_SENSOR_TRANSPORT=usb-uart
AIRMONITOR_SENSOR_SERIAL=SGX-VOC-1000-01
AIRMONITOR_SENSOR_LOCATION=
AIRMONITOR_DATABASE=/var/lib/airmonitor/airmonitor.sqlite3
AIRMONITOR_INTERVAL=10
AIRMONITOR_POST_PRINT_CONTEXT_SECONDS=1800
AIRMONITOR_LOG_LEVEL=INFO

# Filament environmental policy used to classify printer materials.
AIRMONITOR_FILAMENT_POLICY=/etc/airmonitor/filament-policy.yaml

# Local printer state MQTT, published by airmonitor-printer-mqtt.
AIRMONITOR_PRINTER_MQTT=true
AIRMONITOR_LOCAL_MQTT_HOST=localhost
AIRMONITOR_LOCAL_MQTT_PORT=1883
AIRMONITOR_LOCAL_MQTT_TOPIC=printer/state
AIRMONITOR_LOCAL_MQTT_AVAILABILITY_TOPIC=printer/available
AIRMONITOR_LOCAL_MQTT_CLIENT_ID=airmonitor
AIRMONITOR_LOCAL_MQTT_USERNAME=
AIRMONITOR_LOCAL_MQTT_PASSWORD=
