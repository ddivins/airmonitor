# Bambu printer local MQTT authentication.
# Copy to /etc/printer-mqtt-service.env and set mode 0600.

# Printer LAN IP or DNS name.
PRINTER_HOST=192.168.3.x

# Printer serial number used in the native Bambu MQTT topic.
PRINTER_SERIAL=YOUR_PRINTER_SERIAL

# Local printer access code from the printer UI / Bambu app.
PRINTER_ACCESS_CODE=YOUR_LOCAL_ACCESS_CODE

# Bambu local MQTT settings.
PRINTER_MQTT_PORT=8883
PRINTER_MQTT_USERNAME=bblp
PRINTER_MQTT_KEEPALIVE=60
PRINTER_MQTT_TOPIC=

# Local MQTT broker used by AirMonitor, Bento, dashboards, etc.
LOCAL_MQTT_HOST=localhost
LOCAL_MQTT_PORT=1883
LOCAL_MQTT_USERNAME=
LOCAL_MQTT_PASSWORD=
LOCAL_MQTT_TOPIC_PREFIX=printer
LOCAL_MQTT_CLIENT_ID=printer-mqtt-service

# Service behavior.
RECONNECT_DELAY=15
WATCHDOG_SECONDS=300
HEARTBEAT_SECONDS=600
PUBLISH_RAW=false
LOG_LEVEL=INFO
